# Auto-detect text files and ensure normalized LF line endings
* text=auto eol=lf

# Force LF for shell scripts (critical for bash execution)
*.sh text eol=lf

# Force LF for Docker and config files
compose.yml text eol=lf
compose.prod.yml text eol=lf
*.ini text eol=lf
*.env text eol=lf
.env.example text eol=lf

# Binary files — don't touch
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
