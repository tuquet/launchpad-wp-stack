# =============================================================================
# LaunchPad WordPress Stack - Environment Configuration
# File này chỉ chứa placeholder. Chạy scripts/copy-env.sh để tự động sinh secrets.
# =============================================================================

# Docker Compose
COMPOSE_FILE=compose.yml

# ── Database (MariaDB) ──────────────────────────────────────────────────────
DB_NAME=wordpress
DB_USER=wp_user
DB_PASSWORD=tobemodified_db_password
DB_ROOT_PASSWORD=tobemodified_db_root_password
DB_PORT=3306

# ── WordPress ───────────────────────────────────────────────────────────────
WP_PORT=8080
WP_TABLE_PREFIX=wp_

# WordPress Authentication Keys & Salts (https://api.wordpress.org/secret-key/1.1/salt/)
WP_AUTH_KEY=tobemodified_auth_key
WP_SECURE_AUTH_KEY=tobemodified_secure_auth_key
WP_LOGGED_IN_KEY=tobemodified_logged_in_key
WP_NONCE_KEY=tobemodified_nonce_key
WP_AUTH_SALT=tobemodified_auth_salt
WP_SECURE_AUTH_SALT=tobemodified_secure_auth_salt
WP_LOGGED_IN_SALT=tobemodified_logged_in_salt
WP_NONCE_SALT=tobemodified_nonce_salt

# WordPress Debug (true / false)
WP_DEBUG=false

# ── PHP Configuration ──────────────────────────────────────────────────────
PHP_UPLOAD_MAX_FILESIZE=256M
PHP_POST_MAX_SIZE=256M
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=300
PHP_MAX_INPUT_VARS=5000
